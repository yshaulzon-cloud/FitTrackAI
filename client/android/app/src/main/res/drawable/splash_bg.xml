<?xml version="1.0" encoding="utf-8"?>
<!-- Window background for the launch theme (Android 11 and below, and the gap
     before the plugin's splash view appears): the brand navy underneath the
     transparent splash artwork, so nothing grey/white shows through around the
     logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/splash_background" />
    </item>
    <item>
        <bitmap android:src="@drawable/splash" />
    </item>
</layer-list>
